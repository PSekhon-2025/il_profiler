# Copy to ".env" and paste your Together AI API key. Never commit the real key.
TOGETHER_API_KEY=your_together_api_key_here

# Optional. Absolute path to the raw dataset tree (<root>/<Org>/<Category>/*.pdf).
# Set it to make the Audit tab's [excerpt N] citations link to the source PDF;
# leave it unset and they render as plain text, exactly as before. Local only —
# the cloud deployment ships no corpus and disables the links outright.
# IL_PROFILER_DATASET_ROOT=C:/path/to/dataset
